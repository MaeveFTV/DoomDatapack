{
    "name": "Advanced Fairy Wings",
    "description": "You've reached a new level and have better preforming fairy wings.",
    "type": "origins:action_on_callback",
    "entity_action_gained": {
        "type": "origins:and",
        "actions": [
            {
                "type": "origins:execute_command",
                "command": "curios add back @s 1"
            },
            {
                "type": "origins:execute_command",
                "command": "curios replace back 1 @s with icarus:white_light_wings{Enchantments: [{lvl: 1, id: \"minecraft:vanishing_curse\"}, {lvl: 1, id: \"minecraft:binding_curse\"}]} 1"
            }
        ]
    },
    "execute_chosen_when_orb": true,
    "entity_action_lost": {
        "type": "origins:and",
        "actions": [
            {
            "type": "origins:execute_command",
            "command": "curios replace back 1 @s with air 1"
            },
            {
                "type": "origins:execute_command",
                "command":"curios remove back @s 1"
            }
        ]
    },
    "entity_action_respawned": {
        "type": "origins:and",
        "actions": [
            {
                "type": "origins:execute_command",
                "command": "curios replace back 1 @s with icarus:white_light_wings{Enchantments: [{lvl: 1, id: \"minecraft:vanishing_curse\"}, {lvl: 1, id: \"minecraft:binding_curse\"}]} 1"
            }
        ]
    }
}